<Solution>
  <Folder Name="/src/">
    <Project Path="src/Bokmal.Api/Bokmal.Api.csproj" />
    <Project Path="src/Bokmal.Database/Bokmal.Database.csproj" />

    <!--
      The frontend, present so it can be browsed from Solution Explorer, but excluded from
      the solution build.

      It is not built by MSBuild because it is not built by MSBuild anywhere: `next build`
      is driven by npm, and wiring that into the solution would make `dotnet build` depend
      on Node being installed and node_modules being restored. The C# side has to keep
      building on a machine that has never run npm.

      The usual split applies anyway. The frontend is developed in VS Code and the backend
      in Visual Studio; this node is here to read and navigate, not to compile.
    -->
    <Project Path="src/Bokmal.Web/Bokmal.Web.esproj">
      <Build Solution="*|*" Project="false" />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Bokmal.Tests/Bokmal.Tests.csproj" />
  </Folder>
</Solution>
